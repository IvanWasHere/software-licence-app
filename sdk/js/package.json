{
  "name": "@licence-app/sdk",
  "version": "0.1.0",
  "description": "Validate, activate and deactivate licenses against a Licence App server. Zero dependencies, signature-verified, offline-tolerant.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./node": {
      "types": "./dist/esm/node.d.ts",
      "import": "./dist/esm/node.js",
      "require": "./dist/cjs/node.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.types.json && tsc -p tsconfig.cjs.json && node scripts/cjs-package.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "size": "npm run build && node scripts/size.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "typescript": "~6.0.3"
  }
}
