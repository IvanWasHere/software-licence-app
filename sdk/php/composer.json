{
    "name": "licence-app/sdk",
    "description": "Validate, activate and update licensed PHP software and WordPress plugins against a Licence App server.",
    "type": "library",
    "license": "MIT",
    "keywords": ["license", "licensing", "wordpress", "updates", "ed25519"],
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "ext-sodium": "*"
    },
    "suggest": {
        "ext-curl": "For CurlHttpClient outside WordPress; inside WordPress the SDK uses wp_remote_request."
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": { "LicenceApp\\Sdk\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "LicenceApp\\Sdk\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null"
    },
    "config": {
        "sort-packages": true
    }
}
