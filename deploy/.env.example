# ==============================================================================
# Production settings for deploy/compose.yaml — copy to deploy/.env.
# Compose reads this file both for ${…} in compose.yaml and as every app
# container's environment. Keep it out of git (it is ignored) and readable by
# root only: `chmod 600 .env`.
# ==============================================================================

# --- Where it lives -----------------------------------------------------------
DOMAIN=licensing.example.com          # A/AAAA records point at this machine
ACME_EMAIL=ops@example.com           # Let's Encrypt expiry notices
IMAGE_TAG=latest                     # set to a git sha to pin a release (runbooks)

# --- App ----------------------------------------------------------------------
TZ=UTC
LOG_LEVEL=info
APP_NAME="Acme Licenses"
APP_KEY=                             # node ace generate:key --show — never change it later
SESSION_DRIVER=cookie

# --- Database (the postgres container) ----------------------------------------
POSTGRES_USER=licence
POSTGRES_DB=licence
POSTGRES_PASSWORD=                   # openssl rand -hex 24  (URL-safe)

# --- Licensing ----------------------------------------------------------------
LICENSE_SIGNING_KEY=                 # node ace licensing:keygen — back it up offline
LICENSE_SIGNING_KEY_ID=k1
# LICENSE_SIGNING_EXTRA_PUBLIC_KEYS= # kid:pubkey,… during a rotation (runbooks)
# LICENSE_API_RATE_PER_ADDRESS=120
# LICENSE_API_RATE_PER_KEY=30

# --- Payments (Creem) ---------------------------------------------------------
PAYMENT_PROVIDER=creem
CREEM_API_KEY=
CREEM_API_URL=https://api.creem.io
CREEM_WEBHOOK_SECRET=                # webhook URL: https://$DOMAIN/webhooks/creem

# --- Mail (Resend) ------------------------------------------------------------
MAIL_MAILER=resend
RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
MAIL_FROM_ADDRESS=licenses@example.com   # a domain verified in Resend (SPF + DKIM)
MAIL_FROM_NAME="Acme"

# --- Receipts -----------------------------------------------------------------
# Printed on every receipt PDF. Creem issues the tax invoice; this is the order
# receipt from your company. `|` separates address lines.
COMPANY_NAME="Acme Ltd"
COMPANY_ADDRESS="1 Example Street|12345 Example City|Country"
COMPANY_EMAIL=billing@example.com
COMPANY_TAX_ID=                      # shown when set, e.g. a VAT or company number

# --- Storage ------------------------------------------------------------------
# r2 is recommended: release zips and uploads live off the machine, and bucket
# versioning is their backup. With fs they live in the `uploads` volume and
# the nightly backup tars them.
DRIVE_DISK=r2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=                         # https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=                       # custom domain for the public disk (logos)

# --- Back-office --------------------------------------------------------------
ADMIN_IP_ALLOWLIST=                  # your office/VPN addresses, comma-separated

# --- Rate limiting / queue ----------------------------------------------------
LIMITER_STORE=database
QUEUE_WORKER_CONCURRENCY=5
QUEUE_POLL_INTERVAL_MS=1000
CSP_REPORT_ONLY=false

# --- Backups (the backup container) -------------------------------------------
BACKUP_AT=02:30                      # UTC
BACKUP_KEEP_DAYS=14                  # kept on this machine
# Off-site copies with rclone. For an R2 bucket named licence-backups:
# BACKUP_REMOTE=r2:licence-backups/db
# RCLONE_CONFIG_R2_TYPE=s3
# RCLONE_CONFIG_R2_PROVIDER=Cloudflare
# RCLONE_CONFIG_R2_ACCESS_KEY_ID=
# RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
# RCLONE_CONFIG_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
