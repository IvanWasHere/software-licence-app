{{--
  Public site: the product list, pricing pages, the post-checkout page, and
  the error pages reachable while signed out. Its only state is "is someone
  signed in", which decides whether the header offers Sign in or the
  customer's licenses. Sign up stays on the login page, but most accounts
  are made by buying (licence plan M5).
--}}
@component('layouts/base', { title: $props.get('title') })
  <header class="marketing-header">
    <a href="{{ urlFor('home') }}" class="logo" style="margin-bottom: 0">
      <span class="logo-icon">
        @!icon({ name: 'layers' })
      </span>
      <span class="logo-text">{{ appName }}</span>
    </a>

    <nav class="marketing-nav">
      <a href="{{ urlFor('home') }}">Products</a>
      @if(auth.user)
        @!link({ route: 'licenses.index', text: 'Your licenses', class: 'btn btn-primary btn-sm' })
      @else
        @!link({ route: 'auth.session.create', text: 'Sign in', class: 'btn btn-outline btn-sm' })
      @end
    </nav>
  </header>

  <main class="marketing-main">
    {{{ await $slots.main() }}}
  </main>

  <footer class="marketing-footer">
    &copy; {{ new Date().getFullYear() }} {{ appName }}
  </footer>
@end
