{{--
  The customer sidebar (licence plan M5).

  Every item is guarded by `hasRoute`, and the account features by the flags
  `RequireOrganizationMiddleware` shares: with one seat there is no team to
  manage, with no storage no Files screen, with no API keys no API Keys screen.
  A staff override on the account brings each back.
--}}
@let(navIsOwner = state.isOwner ?? false)

<div class="nav-section-title">Main</div>

@if(hasRoute('dashboard.index'))
  @!navItem({ route: 'dashboard.index', icon: 'barChart', label: 'Overview' })
@end
@if(hasRoute('licenses.index'))
  @!navItem({ route: 'licenses.index', icon: 'key', label: 'Licenses' })
@end
@if(state.filesEnabled && hasRoute('files.index'))
  @!navItem({ route: 'files.index', icon: 'folder', label: 'Files' })
@end

@if(state.teamEnabled && hasRoute('members.index'))
  <div class="nav-section-title">Team</div>
  @!navItem({ route: 'members.index', icon: 'users', label: 'Members' })
@end

<div class="nav-section-title">Account</div>

{{-- Billing and API keys are owner-only (plan §6) --}}
@if(navIsOwner && hasRoute('billing.index'))
  @!navItem({ route: 'billing.index', icon: 'creditCard', label: 'Billing' })
@end
@if(navIsOwner && state.apiKeysEnabled && hasRoute('api_keys.index'))
  @!navItem({ route: 'api_keys.index', icon: 'key', label: 'API Keys' })
@end
@if(hasRoute('settings.profile'))
  @!navItem({ route: 'settings.profile', icon: 'settings', label: 'Settings' })
@end
