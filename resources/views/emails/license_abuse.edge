@component('emails/layout', {
  title: 'Licenses flagged',
  footer: 'You are receiving this because you are an admin of this back-office.',
})
  <p style="margin: 0 0 12px; font-size: 20px; font-weight: 700; color: #111827;">
    {{ flags.length === 1 ? 'A license was flagged for review' : `${flags.length} licenses were flagged for review` }}
  </p>
  <p style="margin: 0 0 20px; font-size: 14px; line-height: 1.6; color: #4b5563;">
    Nothing has been changed. A busy agency and a shared key can look alike — open each one and decide.
  </p>
  @each(flag in flags)
    <table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; margin: 0 0 12px; border: 1px solid #e5e7eb; border-radius: 8px;">
      <tr>
        <td style="padding: 14px 16px; font-size: 13px; line-height: 1.6; color: #374151;">
          <strong>{{ flag.product }}</strong> · {{ flag.account }} · key ending {{ flag.keySuffix }}<br />
          {{ flag.description }}: {{ flag.summary }}.<br />
          <a href="{{ flag.url }}" style="color: #3b82f6;">Open the license</a>
        </td>
      </tr>
    </table>
  @end
@end
