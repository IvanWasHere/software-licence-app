{{--
  Billing for a licensing account (licence plan §6, M5). Owner-only.

  A record, not a shop: licenses are bought on a product's pricing page.
  Changing a card, downloading an invoice or cancelling happens in the
  payment provider's own portal, and comes back to us as a webhook.
--}}
@component('layouts/app', { title: 'Billing' })
  @pageHeader({
    title: 'Billing',
    description: 'Your subscriptions, orders and every charge we have a record of.',
  })
    @slot('actions')
      @if(subscriptions.length)
        @form({ route: 'billing.portal', method: 'POST', id: 'portal-form' })
          @!button({ text: 'Manage payment & invoices', variant: 'outline', size: 'sm', type: 'submit' })
        @end
      @end
    @end
  @end

  @panel.root({ title: 'Subscriptions', flush: true })
    @if(subscriptions.length)
      <div class="table-scroll">
        <table class="tx-table">
          <thead><tr><th>Product · plan</th><th>Status</th><th>Current period ends</th></tr></thead>
          <tbody>
            @each(subscription in subscriptions)
              <tr>
                <td>{{ subscription.plan.product.name }} · {{ subscription.plan.name }}</td>
                <td>
                  @if(subscription.status === 'past_due')
                    @!badge({ text: 'Payment failed', tone: 'warning' })
                  @elseif(subscription.isEndingSoon)
                    @!badge({ text: 'Ends at period end', tone: 'warning' })
                  @elseif(subscription.isEntitling)
                    @!badge({ text: 'Active', tone: 'success' })
                  @else
                    @!badge({ text: subscription.status, tone: 'neutral' })
                  @end
                </td>
                <td style="white-space: nowrap">
                  {{ subscription.currentPeriodEnd ? subscription.currentPeriodEnd.setZone(organization.timezone).toFormat('d LLL yyyy') : '—' }}
                </td>
              </tr>
            @end
          </tbody>
        </table>
      </div>
      @if(subscriptions.some((subscription) => subscription.status === 'past_due'))
        <p class="field-hint" style="padding: 0 16px 16px">
          A failed renewal does not switch anything off straight away: the license keeps working for
          {{ renewalGraceDays }} days after the paid period ends while the payment is retried. Update your
          card in the portal to keep it that way.
        </p>
      @end
    @else
      @!emptyState({
        icon: 'creditCard',
        title: 'No subscriptions',
        description: 'Yearly and monthly licenses appear here. One-time purchases have nothing to renew.',
      })
    @end
  @end

  @panel.root({ title: 'Orders', flush: true })
    @if(orders.length)
      <div class="table-scroll">
        <table class="tx-table">
          <thead><tr><th>Order</th><th>What</th><th>Date</th><th>Total</th><th>Status</th></tr></thead>
          <tbody>
            @each(order in orders)
              <tr>
                <td><span class="tx-id">{{ order.publicId }}</span></td>
                <td>
                  @each(item in order.items)
                    <div>{{ item.plan.product.name }} · {{ item.plan.name }}</div>
                  @end
                </td>
                <td style="white-space: nowrap">{{ (order.paidAt ?? order.createdAt).setZone(organization.timezone).toFormat('d LLL yyyy') }}</td>
                <td>{{ money(order.totalCents, order.currency) }}</td>
                <td>
                  @if(order.status === 'refunded')
                    @!badge({ text: 'Refunded', tone: 'refunded' })
                  @elseif(order.status === 'partially_refunded')
                    @!badge({ text: 'Part refunded', tone: 'warning' })
                  @else
                    @!badge({ text: 'Paid', tone: 'success' })
                  @end
                </td>
              </tr>
            @end
          </tbody>
        </table>
      </div>
    @else
      @!emptyState({
        icon: 'shoppingBag',
        title: 'No orders yet',
        description: 'Licenses you buy appear here once the payment is confirmed.',
      })
    @end
  @end

  <h2 class="section-title">Transaction history</h2>
  <p class="section-desc">Every charge and refund, including renewals.</p>

  @panel.root({ flush: true })
    @if(payments.length)
      <div class="table-scroll">
        <table class="tx-table">
          <thead>
            <tr><th>Reference</th><th>Description</th><th>Date</th><th>Amount</th><th>Status</th></tr>
          </thead>
          <tbody>
            @each(payment in payments)
              <tr>
                <td><span class="tx-id">{{ payment.publicId }}</span></td>
                <td>{{ payment.description ?? 'Payment' }}</td>
                <td style="white-space: nowrap">
                  {{ payment.occurredAt.setZone(organization.timezone).toFormat('d LLL yyyy') }}
                </td>
                <td>
                  <span class="tx-amount {{ payment.isRefunded ? 'refund' : '' }}">
                    {{ payment.formattedAmount }}
                  </span>
                </td>
                <td>
                  @if(payment.status === 'refunded')
                    @!badge({ text: 'Refunded', tone: 'refunded' })
                  @elseif(payment.status === 'partially_refunded')
                    @!badge({ text: 'Part refunded', tone: 'warning' })
                  @elseif(payment.status === 'disputed')
                    @!badge({ text: 'Disputed', tone: 'danger' })
                  @else
                    @!badge({ text: 'Paid', tone: 'success' })
                  @end
                </td>
              </tr>
            @end
          </tbody>
        </table>
      </div>
    @else
      @!emptyState({
        icon: 'creditCard',
        title: 'No transactions yet',
        description: 'Charges and refunds appear here as soon as the payment provider confirms them.',
      })
    @end
  @end
@end
