{{--
  The home page (licence plan M5): every product on sale, each linking to its
  pricing page. What a product costs is on that page; this one only says what
  there is and where to start.
--}}
@component('layouts/marketing', { title: 'Products' })
  <section class="hero">
    <h1 class="hero-title">{{ appName }}</h1>
    <p class="hero-subtitle">
      Buy a license, enter the key in the software, and manage every site that uses it from your
      account.
    </p>
    <div class="hero-actions">
      @if(auth.user)
        @!link({ route: 'licenses.index', text: 'Your licenses', class: 'btn btn-primary' })
      @else
        @!link({ route: 'auth.session.create', text: 'Sign in to your account', class: 'btn btn-outline' })
      @end
    </div>
  </section>

  <section class="marketing-section">
    @if(products.length)
      <div class="feature-grid">
        @each(product in products)
          <div class="feature-card">
            <h2 class="feature-title">{{ product.name }}</h2>
            @if(product.description)
              <p class="feature-desc">{{ product.description }}</p>
            @end
            @if(product.plans.length)
              <p class="field-hint">
                From {{ money(product.plans[0].priceCents, product.plans[0].currency) }}
                · {{ product.plans.length }} {{ product.plans.length === 1 ? 'plan' : 'plans' }}
              </p>
            @end
            <div class="btn-row">
              <a class="btn btn-primary btn-sm" href="{{ urlFor('storefront.pricing', { product: product.slug }) }}">See pricing</a>
              @if(product.homepageUrl)
                <a class="btn btn-ghost btn-sm" href="{{ product.homepageUrl }}" rel="noopener">Learn more</a>
              @end
            </div>
          </div>
        @end
      </div>
    @else
      <p class="hero-subtitle">Nothing is on sale yet.</p>
    @end
  </section>
@end
