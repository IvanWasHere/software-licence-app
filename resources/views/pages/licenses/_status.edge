@if(license.isRevoked)
  @!badge({ text: 'Revoked', tone: 'danger' })
@elseif(license.isSuspended)
  @!badge({ text: 'Suspended', tone: 'warning' })
@elseif(license.isExpired)
  @!badge({ text: 'Expired', tone: 'neutral' })
@elseif(license.subscription && !license.subscription.isEntitling)
  @!badge({ text: 'Subscription ended', tone: 'neutral' })
@elseif(license.subscription && license.subscription.status === 'past_due')
  @!badge({ text: 'Payment due', tone: 'warning' })
@else
  @!badge({ text: 'Active', tone: 'success' })
@end
