SESSION_DRIVER=memory
DB_CONNECTION=sqlite
DB_SQLITE_PATH=:memory:

# Payments. Real-looking values so the billing suite exercises the actual
# signature check rather than a path
# that only runs in tests.
CREEM_API_KEY=test-api-key
CREEM_WEBHOOK_SECRET=test-webhook-secret
# A closed local port: a test that forgets the fake provider fails at once
# instead of calling Creem over the network.
CREEM_API_URL=http://127.0.0.1:9

# Uploads land somewhere disposable rather than in the working directory.
DRIVE_DISK=fs
DRIVE_FS_ROOT=tmp/test-storage

# In-memory rate limiting, so one test's traffic is not another's limit.
LIMITER_STORE=memory
